# .env.example

# JWT secret for signing tokens (change in production)
JWT_SECRET=replace_with_secure_secret

# Optional OpenAI API key to enable Evo AI with real LLM responses
OPENAI_API_KEY=

# Optional Redis URL for caching (redis://...)
REDIS_URL=

# Admin key for initial bootstrap only (you can use this to create the first admin account), keep secret
ADMIN_KEY=replace_with_admin_key
